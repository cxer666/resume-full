{
  "manifest_version": 3,
  "name": "简历填写助手",
  "version": "0.1.6",
  "description": "读取本地简历库，辅助填写和检查招聘网站简历表单。",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:17888/*",
    "<all_urls>"
  ],
  "action": {
    "default_title": "简历填写助手",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}


